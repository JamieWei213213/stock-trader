# Copy this file to .env and fill in. Never commit .env.

# Alpaca paper account #1 ($1k). Create it in the Alpaca dashboard (Paper -> create new account, $1,000).
ALPACA_SMALL_KEY=
ALPACA_SMALL_SECRET=

# Alpaca paper account #2 ($100k). The default paper account is already $100k.
ALPACA_LARGE_KEY=
ALPACA_LARGE_SECRET=

# Anthropic API key (console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=

# Finnhub (free) — earnings calendar for the earnings blackout. finnhub.io -> sign up -> API key
FINNHUB_KEY=

# Login for the web dashboard on the VPS (pick anything; used by vps/serve.py)
DASH_USER=jamie
DASH_PASS=
